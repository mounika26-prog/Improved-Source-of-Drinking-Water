# ============================================================
#  IBM Cloud watsonx.ai Runtime — Credential Template
#  PS-38: Improved Source of Drinking Water
#  IBM SkillsBuild Internship
#
#  INSTRUCTIONS:
#    1. Copy this file to .env  (never commit .env to git)
#    2. Fill in every value using the steps in DEPLOYMENT.md
#    3. This project uses only FREE Lite plan resources
# ============================================================

# ----------------------------------------------------------
# 1. IBM Cloud IAM API Key
#    Where to get: cloud.ibm.com → Manage → Access (IAM)
#                  → API keys → Create
# ----------------------------------------------------------
IBM_CLOUD_API_KEY=USk8HgkVMRaFeV2NVrx-OYOnoH_SHv7ABNaf1P43E8Sb

# ----------------------------------------------------------
# 2. watsonx.ai Runtime Service URL
#    Match the region where you provisioned the service.
#    Dallas (us-south) is the most common free-tier region.
#
#    Dallas  : https://us-south.ml.cloud.ibm.com
#    London  : https://eu-gb.ml.cloud.ibm.com
#    Frankfurt: https://eu-de.ml.cloud.ibm.com
#    Tokyo   : https://jp-tok.ml.cloud.ibm.com
# ----------------------------------------------------------
WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# ----------------------------------------------------------
# 3. watsonx.ai Studio Project ID
#    Where to get: dataplatform.cloud.ibm.com → your project
#                  → Manage → General → Project ID
# ----------------------------------------------------------
WATSONX_PROJECT_ID=2643ec8f-a631-4430-aff4-bb62a20bd95c

# ----------------------------------------------------------
# 4. watsonx.ai Runtime Service Instance ID
#    Where to get: cloud.ibm.com → Resource list
#                  → your watsonx.ai Runtime instance
#                  → Details → GUID / Instance ID
# ----------------------------------------------------------
WATSONX_INSTANCE_ID=fe1327f2-23dc-4011-8ec1-3c25887ae2c0

# ----------------------------------------------------------
# 5. IBM Cloud Object Storage (COS) Credentials
#    Automatically created when you create a project.
#    Where to get: cloud.ibm.com → Resource list
#                  → Cloud Object Storage → Service credentials
#                  → New credential (role: Writer)
#    Note: The free COS Lite plan includes 25 GB storage.
# ----------------------------------------------------------
COS_API_KEY=your_cos_api_key_here
COS_INSTANCE_ID=your_cos_resource_instance_id_here
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET_NAME=your_project_bucket_name_here

# ----------------------------------------------------------
# LITE PLAN LIMITS (do not exceed — no charges incurred):
#   watsonx.ai Studio  : 10 CUH / month, 1 user
#   watsonx.ai Runtime : 20 CUH / month, 300,000 tokens/month
#   Cloud Object Storage: 25 GB free (12 months)
# ----------------------------------------------------------
